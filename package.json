{
  "name": "videoos",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "web:dev": "node apps/web/server.mjs",
    "web:start": "node apps/web/server.mjs",
    "alpha:up": "docker compose -f infra/compose.alpha.yml up --build -d",
    "alpha:down": "docker compose -f infra/compose.alpha.yml down",
    "alpha:logs": "docker compose -f infra/compose.alpha.yml logs -f --tail=200 web",
    "mvp:smoke": "pnpm --filter @videoos/local-runtime mvp:smoke",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test && node --test apps/web/test/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "architecture:check": "node tooling/architecture-check.mjs",
    "launch:check": "node tooling/launch-check.mjs",
    "generate:service": "node tooling/generate-service.mjs",
    "generate:adapter": "node tooling/generate-adapter.mjs",
    "quality": "pnpm architecture:check && pnpm lint && pnpm typecheck && pnpm test"
  }
}
